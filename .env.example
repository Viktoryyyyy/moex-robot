# Telegram Bot API credentials
BOT_TOKEN=
CHAT_ID=

# MOEX public/general API credential, if a non-Algopack integration requires it.
# This variable is not accepted as a fallback for subscribed AlgoPack routes.
MOEX_API_KEY=

# MOEX AlgoPack subscription Bearer token.
# Required by subscribed AlgoPack runners such as Phase 8.6A CNYRUB_TOM validation.
# Keep the real value only in the project-local .env file; never commit it.
MOEX_ALGOPACK_TOKEN=

# RUB Intelligence Flowise Decision Agent runtime configuration.
# Non-secret Applied State endpoint verified in Flowise on 2026-08-10.
MOEX_RUB_INTELLIGENCE_FLOWISE_ENDPOINT=https://flowise.foods-tech.store/api/v1/prediction/9ad1f42c-e7f1-44a3-a574-09a7da4ddecf
MOEX_RUB_INTELLIGENCE_FLOWISE_REQUEST_FIELD=question
MOEX_RUB_INTELLIGENCE_FLOWISE_RESPONSE_FIELD=text
MOEX_RUB_INTELLIGENCE_FLOWISE_TIMEOUT_SECONDS=20

# RUB Intelligence Flowise News Classifier runtime configuration.
# Non-secret Applied State endpoint verified in Flowise on 2026-08-10.
MOEX_RUB_INTELLIGENCE_NEWS_CLASSIFIER_FLOWISE_ENDPOINT=https://flowise.foods-tech.store/api/v1/prediction/69b38496-7013-4474-be6c-7dce43177b95
MOEX_RUB_INTELLIGENCE_NEWS_CLASSIFIER_FLOWISE_REQUEST_FIELD=question
MOEX_RUB_INTELLIGENCE_NEWS_CLASSIFIER_FLOWISE_RESPONSE_FIELD=text
MOEX_RUB_INTELLIGENCE_NEWS_CLASSIFIER_FLOWISE_TIMEOUT_SECONDS=20
