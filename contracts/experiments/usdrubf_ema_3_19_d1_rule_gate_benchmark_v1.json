    },
    {
      "artifact_id": "usdrubf_d1_ema_3_19_multi_horizon_labels",
      "contract_class": "cli_argument",
      "cli_arg": "--labels-path",
      "formats": [
        "csv",
        "parquet"
      ],
      "source_experiment_id": "usdrubf_ema_3_19_d1_indicators_horizons_v1",
      "sha256_required_before_analysis": true,
