    },
    {
      "filename": "m4b_decision.json",
      "format": "json",
      "artifact_role": "mechanical frozen-condition decision"
    }
  ],
  "artifact_write_policy": {
    "output_dir_arg": "--output-dir",
    "absent_or_empty_required": true,
    "all_outputs_below_output_dir": true,
    "declared_outputs_only": true,
