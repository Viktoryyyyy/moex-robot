{
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_class": {"minLength": 1, "type": "string"},
        "artifact_id": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "type": "string"},
        "artifact_role": {"minLength": 1, "type": "string"},
        "consumer": {"minLength": 1, "type": "string"},
        "filename": {"minLength": 1, "type": "string"},
        "format": {"minLength": 1, "type": "string"},
        "producer": {"minLength": 1, "type": "string"},
        "required_for_canonical": {"type": "boolean"},
        "schema_version": {
          "oneOf": [
            {"minLength": 1, "type": "string"},
            {"minimum": 1, "type": "integer"}
          ]
        }
      },
      "required": [
        "filename",
        "artifact_id",
        "artifact_role",
        "format",
        "schema_version",
        "required_for_canonical"
      ],
      "type": "object"
    }
  },
  "$id": "research_run_registration_v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {"items": {"$ref": "#/$defs/artifact"}, "minItems": 1, "type": "array"},
    "canonicality_status": {"enum": ["canonical", "provisional", "non_canonical", "blocked"]},
    "created_ts": {"minLength": 1, "type": "string"},
    "dataset_refs": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "feature_refs": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "instrument_scope": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "label_refs": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
    "metrics": {"type": "object"},
    "parameter_set": {"type": "object"},
    "repo_commit": {"pattern": "^[0-9a-fA-F]{40}$", "type": "string"},
    "result_status": {
      "enum": [
        "supported_canonical",
        "not_supported_canonical",
        "supported_provisional",
        "not_supported_provisional",
        "blocked",
        "invalidated",
        "evidence_canonical",
        "evidence_provisional"
      ]
    },
    "run_id": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "type": "string"},
    "run_status": {"enum": ["planned", "executed", "blocked", "failed", "invalidated", "superseded"]},
    "schema_version": {"const": "research_run_registration.v1"},
    "strategy_id": {"minLength": 1, "type": "string"},
    "strategy_version": {"minLength": 1, "type": "string"},
    "test_type": {"minLength": 1, "type": "string"},
    "timeframe_scope": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true}
  },
  "required": [
    "schema_version",
    "run_id",
    "strategy_id",
    "strategy_version",
    "test_type",
    "instrument_scope",
    "timeframe_scope",
    "repo_commit",
    "run_status",
    "result_status",
    "canonicality_status",
    "dataset_refs",
    "feature_refs",
    "label_refs",
    "parameter_set",
    "metrics",
    "artifacts"
  ],
  "title": "MOEX Bot research run registration v1",
  "type": "object"
}
