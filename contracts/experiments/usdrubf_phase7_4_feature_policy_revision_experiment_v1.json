  "exact_feature_definitions": {
    "lag1_intersession_gap_days": {
      "formula": "calendar_days(trade_date_(t-1) - trade_date_(t-2))"
    },
    "lag1_ema_3_slope_5_pct": {
      "formula": "EMA3_(t-1) / EMA3_(t-6) - 1"
    },
    "lag1_hl_range_to_prior20_mean": {
      "formula": "h_(t-1) / mean(h_s for s in [t-21,t-2]) - 1"
    },
    "lag1_log_avg_trade_value_rel_prior20": {
      "formula": "log1p(A_(t-1)/N_(t-1)) - mean(log1p(A_s/N_s) for s in [t-21,t-2])"
    }
  },
  "ema_semantics": {
