    "dir_rsi_centered": "direction * (rsi_14 - 50)",
    "dir_stoch_k_centered": "direction * (stoch_k_14 - 50)",
    "dir_stoch_d_centered": "direction * (stoch_d_3 - 50)",
    "dir_di_spread": "direction * di_spread_14",
    "dir_macd_hist": "direction * macd_hist_12_26_9_pct",
    "dir_bb_position": "direction * (bb_percent_b_20_2 - 0.5)"
  },
  "feature_groups": {
    "direction_only": {
      "numeric": [],
      "categorical": ["cross_dir"],
      "candidate": false
    },
    "momentum": {
      "numeric": [
        "dir_roc_10",
        "dir_rsi_centered",
        "dir_stoch_k_centered",
        "dir_stoch_d_centered"
      ],
      "categorical": ["cross_dir"],
      "candidate": true
    },
    "trend": {
      "numeric": ["adx_14", "dir_di_spread", "dir_macd_hist"],
      "categorical": ["cross_dir"],
      "candidate": true
    },
    "volatility": {
      "numeric": ["atr_14_pct", "dir_bb_position", "bb_bandwidth_20_2"],
      "categorical": ["cross_dir"],
      "candidate": true
    },
    "full_technical": {
      "numeric": [
        "dir_roc_10",
        "dir_rsi_centered",
        "dir_stoch_k_centered",
        "dir_stoch_d_centered",
        "adx_14",
        "dir_di_spread",
        "dir_macd_hist",
        "atr_14_pct",
        "dir_bb_position",
        "bb_bandwidth_20_2"
      ],
      "categorical": ["cross_dir"],
      "candidate": true
    }
  },
  "model": {
    "estimator": "sklearn.linear_model.LogisticRegression",
    "C": 1.0,
    "class_weight": "balanced",
    "solver": "liblinear",
    "random_state": 319,
    "probability_mode": "native logistic probability",
    "post_hoc_calibrator": null,
    "persistent_model_artifact": false
  },
  "preprocessing": {
    "numeric_missing_values": "training-fold median",
    "numeric_scaling": "training-fold StandardScaler",
    "categorical_encoding": "training-fold OneHotEncoder with frozen cross_dir categories",
    "fit_scope": "training fold only"
  },
  "validation_protocol": {
    "mode": "expanding_walk_forward",
    "shuffle": false,
    "minimum_initial_train_events_after_purge": 32,
    "test_block_events": 8,
    "final_partial_test_block_allowed": true,
    "purge_d1_sessions": 3,
    "classification_threshold": 0.5,
    "threshold_tuning": false,
    "hyperparameter_search": false,
    "preprocessing_fit_scope": "training fold only"
  },
  "probability_evaluation": {
    "metrics": [
      "roc_auc",
      "pr_auc",
      "brier_score",
      "fold_prevalence_baseline_brier",
      "expected_calibration_error"
    ],
    "calibration_bins": 5,
    "post_hoc_calibration": false
  },
  "policy_evaluation": {
    "threshold": 0.5,
    "metrics": [
      "accepted_events",
      "acceptance_rate",
      "retained_h2_mean_signed_return",
      "retained_h2_median_signed_return",
      "retained_h2_win_rate",
      "policy_h2_mean_return_per_signal"
    ],
    "rejected_event_return_in_policy_metric": 0.0
  },
  "baselines": {
    "no_gate": "all OOS H2-eligible indicator-ready events",
    "fixed_rules": [
      "adx_di",
      "adx_di_momentum",
      "moderate_trend_confirmation"
    ],
    "fixed_rule_semantics_source": "src.moex_research.runners.usdrubf_ema_3_19_d1_rule_gate_benchmark",
    "best_fixed_rule_metric": "highest OOS policy_h2_mean_return_per_signal"
  },
  "negative_controls": {
    "direction_only_feature_group": true,
    "training_label_permutation": {
      "seed": 319,
      "repetitions": 1000,
      "scope": "training labels independently inside each walk-forward fold",
      "oos_labels_unchanged": true,
      "adjustment": "one-sided max-statistic across four candidate feature groups"
    }
  },
  "decision_conditions": {
    "candidate_limits": {
      "minimum_oos_events": 24,
      "minimum_retained_events": 8,
      "minimum_retention_rate": 0.2,
      "maximum_retention_rate": 0.6
    },
    "supported_only_if_all": [
      "ROC AUC > 0.55",
      "Brier score beats fold-local prevalence baseline",
      "Brier score beats direction-only control",
      "retained H2 mean exceeds no_gate",
      "retained H2 median exceeds no_gate",
      "retained H2 win rate exceeds no_gate",
      "policy H2 mean per signal exceeds no_gate",
      "policy H2 mean per signal exceeds the best fixed rule",
      "policy H2 mean per signal exceeds direction-only control",
      "positive policy uplift appears in at least two OOS folds",
      "no single fold supplies more than 70% of positive cumulative policy uplift",
      "max-stat adjusted ROC AUC uplift p-value <= 0.10",
      "max-stat adjusted policy uplift p-value <= 0.10"
    ],
    "fallback_result": "technical_ml_not_supported",
    "supported_result": "technical_ml_supported_for_next_research_phase",
    "model_promotion_allowed": false,
    "strategy_promotion_allowed": false,
    "runtime_or_trading_action_allowed": false
  },
