  "x_policy": {
    "purpose": "Reduce detection latency for market-moving candidate events.",
    "candidate_event_only": true,
    "usable_news_event_requires_confirmation": true,
    "confirmation_sources_allowed": ["OFFICIAL_PRIMARY", "OFFICIAL_SECONDARY", "MAJOR_AGENCY_OR_FINANCIAL_MEDIA"],
    "major_agency_confirmation_requires_approved_route_and_rights": true,
    "blue_check_or_platform_verification_is_not_source_authority": true,
    "multiple_x_reposts_do_not_count_as_independent_confirmation": true,
    "quoted_or_reposted_primary_source_must_be_resolved_to_original_publisher": true,
    "osint_may_trigger_action_directly": false,
    "squawk_may_trigger_action_directly": false,
    "official_x_may_trigger_action_directly": false
  },
  "confirmation_policy": {
    "official_primary_web_or_rss": "One validated official primary publication is sufficient factual authority for the statement it actually contains.",
    "official_secondary": "Use as confirmation only within its institutional scope; prefer primary authority when the event belongs to another institution.",
    "major_agency": "May provide factual authority only through an approved acquisition route and rights policy.",
    "x_any_class": "Discovery only; create or update an unconfirmed candidate cluster until a permitted factual source confirms it.",
    "conflicting_sources": "Keep conflict explicit, lower confidence, and do not collapse contradictory claims into one fact."
  },
  "deduplication_policy": {
    "same_underlying_event_across_sources": "One cluster, not one event per headline.",
    "same_x_post_repeated_by_accounts": "One discovery candidate; repost count is metadata only.",
    "official_update": "May update an existing cluster and change novelty from NEW to UPDATE without creating a duplicate event."
  },
  "rights_and_storage": {
    "default_persist": ["source_id", "source_reference", "timestamps", "normalized headline or bounded metadata when permitted", "content_hash", "cluster metadata", "classification outputs"],
    "raw_full_text_storage_default": false,
    "x_raw_post_storage_default": false,
    "reuters_raw_storage_default": false,
    "redistribution_rights_assumed": false
  },
  "stage12a_boundary": {
    "live_fetch": false,
    "x_api_or_scraping": false,
    "provider_credentials": false,
    "flowise_applied_state": false,
    "scheduler": false,
    "alert_delivery": false,
    "broker_action": false,
    "order_placement": false,
    "autonomous_trading": false,
    "server_apply": false
  },
  "stage12b_entry_gate": [
    "implement only sources whose stage12b_status is READY_CANDIDATE",
    "prove source identity and publication/availability timestamps",
    "reuse existing macro registry sources without duplicating their semantics",
    "retain X as discovery-only unless the base contract is explicitly amended in a separate task",
    "no scraping fallback for blocked or licensed providers",
    "provider-specific storage and rights policy must be explicit before raw-content retention"
  ]
}
