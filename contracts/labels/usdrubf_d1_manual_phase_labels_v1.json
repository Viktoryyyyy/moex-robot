    "B",
    "S",
    "OUT"
  ],
  "label_meanings": {
    "B": "buy_long_regime",
    "S": "sell_short_regime",
    "OUT": "sideways_out_of_market_regime_where_EMA_3_19_loses_effectiveness"
  },
