        "string",
        "null"
      ],
      "allowed_values": [
        "B",
        "S",
        "OUT",
        null
      ],
      "runtime_feature": false
    }
  },
  "boundary_semantics": {
    "start_date": "inclusive",
    "end_date": "inclusive",
    "primary_label_rule": "each normalized D1 session receives exactly one primary phase_label"
  },
  "non_trading_date_mapping": {
    "start_date_non_trading": "map_to_first_valid_D1_session_on_or_after_start_date",
    "end_date_non_trading": "map_to_last_valid_D1_session_on_or_before_end_date",
    "synthetic_rows": "forbidden",
    "session_universe_source": "caller_supplied_D1_session_universe_only"
  },
  "overlap_rule": {
    "known_overlap_date": "2025-09-11",
    "deterministic_rule": "previous_interval_wins_for_primary_label_on_overlap_date",
    "primary_label_for_2025_09_11": "B",
    "transition_exit_day": true,
    "OUT_effective_from": "next_valid_D1_session_after_2025_09_11"
  },
  "time_anchor_rule": {
    "feature_anchor_for_day_D": "D_close_after_finalized_D1_bar",
    "earliest_executable_point": "D_plus_1_open"
  },
  "target_derivation_rules": {
    "primary_phase_classification": "phase_label",
    "transition_end_risk_forecast": [
      "current_regime_ends_within_1d",
      "current_regime_ends_within_3d",
      "current_regime_ends_within_5d"
    ],
    "next_regime_forecast": "next_regime_if_current_ends"
  },
  "leakage_policy": {
    "phase_label_not_runtime_feature": true,
    "transition_targets_not_runtime_features": true,
    "phase_remaining_sessions_not_runtime_feature": true,
    "next_phase_label_not_runtime_feature": true,
    "source_interval_id_not_runtime_feature": true,
    "runtime_AI_assistant_may_consume": [
      "model_outputs",
      "prediction_confidence",
      "feature_freshness_metadata",
      "data_quality_flags"
    ],
    "runtime_AI_assistant_must_not_consume": [
      "manual_phase_labels",
      "future-derived_transition_labels",
      "phase_remaining_sessions",
      "next_phase_label_from_manual_labels"
    ],
    "non_runtime_fields": [
      "phase_label",
      "source_interval_id",
      "transition_exit_day",
      "phase_remaining_sessions",
      "current_regime_ends_within_1d",
