    "gold_label_claim_allowed": false,
    "superseded_if_raw_csv_xlsx_provided": true,
    "source_note": "User confirmed B = buy/long, S = sell/short, OUT = horizontal/sideways out-of-market regime where EMA 3/19 loses edge. Labels are based on daily candles. Boundaries are inclusive."
